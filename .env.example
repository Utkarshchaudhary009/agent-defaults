# Copy to `.env` and fill in real values. NEVER commit the populated `.env`.

# PostgreSQL connection string (Neon or any Postgres-compatible endpoint).
# Local dev example shown here; use your Neon connection string for cloud dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_defaults"

# Server binding (optional)
HOST="127.0.0.1"
PORT="3000"

# Runtime environment (optional): development | production | test
NODE_ENV="development"
